{
  "name": "@voltrix/websocket",
  "version": "0.3.0",
  "description": "High-performance, programmatic-first and decorator-driven WebSocket package with pluggable adapters and distributed pub/sub for Voltrix",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "voltrix",
    "websocket",
    "uWebSockets.js",
    "pubsub",
    "redis",
    "realtime",
    "gateway"
  ],
  "author": "Voltrix Team",
  "license": "MIT",
  "dependencies": {
    "@voltrix/core": "workspace:*",
    "@voltrix/injector": "workspace:*",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.60.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@voltrix/decorator": "workspace:*",
    "@voltrix/server": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "^4.1.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.10"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
