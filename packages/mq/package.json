{
  "name": "@voltrix/mq",
  "version": "0.2.0",
  "description": "High-performance distributed message queue with group concurrency and decorator support for Voltrix",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "bench:perf": "tsx benchmarks/performance.bench.ts",
    "bench:chaos": "tsx benchmarks/chaos.bench.ts",
    "bench:endurance": "tsx benchmarks/endurance.bench.ts",
    "bench:limits": "tsx benchmarks/limits.bench.ts"
  },
  "keywords": [
    "voltrix",
    "mq",
    "message-queue",
    "redis",
    "concurrency",
    "noisy-neighbor"
  ],
  "author": "Voltrix Team",
  "license": "MIT",
  "dependencies": {
    "@voltrix/core": "workspace:*",
    "@voltrix/injector": "workspace:*",
    "cron-parser": "^4.9.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
